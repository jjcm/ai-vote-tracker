# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for model verdicts. https://openrouter.ai/keys
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: live legislation from Congress.gov. https://api.congress.gov/sign-up/
# With a key, each bill's own text (Formatted XML where available) is what the
# models read. Without one the server uses the built-in sample bill corpus.
CONGRESS_API_KEY=

# How this client identifies itself to Congress.gov, the House Clerk and the
# Senate, all of which block requests that do not. Contact details are welcome
# here; blank keeps the built-in value.
# CONGRESS_USER_AGENT=AIVoteTracker/1.0 (you@example.com)

# Start of the analysis window. Bills, model verdicts and the congressional
# floor votes they are compared against all cover legislation that has moved on
# or after this date.
# BILLS_SINCE=2026-06-01

# How many bills a model and a member of Congress must both have taken a side
# on before their agreement rate is ranked on the alignment page.
# CONTENDER_MIN_OVERLAP=3

PORT=8400
HOST=127.0.0.1

# Optional overrides
# DATABASE_PATH=data/aivotes.db
# BOOTSTRAP_BILLS=40
# WEB_DIR=./web

# Share of a model's context window statute text may fill before the bill is
# read section by section instead.
# CONTEXT_BUDGET_RATIO=0.75

# Overrides every model's context window. Development only: it exists to
# exercise the section-digest path without an omnibus-sized bill.
# MODEL_CONTEXT_TOKENS=16000
