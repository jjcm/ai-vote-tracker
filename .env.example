# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for model verdicts. https://openrouter.ai/keys
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: live legislation from Congress.gov. https://api.congress.gov/sign-up/
# Without it the server uses the built-in sample bill corpus.
CONGRESS_API_KEY=

PORT=8400
HOST=127.0.0.1

# Optional overrides
# DATABASE_PATH=data/aivotes.db
# BOOTSTRAP_BILLS=12
# WEB_DIR=./web
